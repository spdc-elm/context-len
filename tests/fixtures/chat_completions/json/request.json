{
  "model": "fixture-chat-model",
  "messages": [
    {
      "role": "system",
      "content": [
        {
          "type": "text",
          "text": "You are a deterministic fixture assistant."
        }
      ]
    },
    {
      "role": "user",
      "content": [
        {
          "type": "text",
          "text": "Call the lookup tool, then answer."
        },
        {
          "type": "image_url",
          "image_url": {
            "url": "https://example.invalid/context-lens-fixture.png",
            "detail": "low"
          }
        }
      ]
    },
    {
      "role": "assistant",
      "content": null,
      "tool_calls": [
        {
          "id": "tool_fixture_a",
          "type": "function",
          "function": {
            "name": "lookup_fixture",
            "arguments": "{\"key\":\"alpha\"}"
          }
        }
      ]
    },
    {
      "role": "tool",
      "tool_call_id": "tool_fixture_a",
      "content": "{\"value\":\"fixture\"}"
    }
  ],
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "lookup_fixture",
        "description": "Return a value from the local fixture table.",
        "parameters": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string"
            }
          },
          "required": [
            "key"
          ],
          "additionalProperties": false
        }
      }
    }
  ],
  "tool_choice": "auto",
  "parallel_tool_calls": true,
  "stream": false,
  "stream_options": {
    "include_usage": true
  },
  "temperature": 0.1,
  "top_p": 0.9,
  "response_format": {
    "type": "json_schema",
    "json_schema": {
      "name": "fixture_answer",
      "strict": true,
      "schema": {
        "type": "object",
        "properties": {
          "answer": {
            "type": "string"
          }
        },
        "required": [
          "answer"
        ],
        "additionalProperties": false
      }
    }
  },
  "unknown_provider_field": {
    "keep": "this"
  }
}
